def _get_fastq_paths(sample):
    if fastq1_map or fastq2_map:
        r1 = fastq1_map.get(sample)
        if sample in fastq2_map:
            return (_abs(r1), _abs(fastq2_map[sample]))
        return (_abs(r1),)
    val = fastq_map[sample]
    if isinstance(val, dict):
        r1 = val.get("r1") or val.get("fastq1") or val.get("read1")
        r2 = val.get("r2") or val.get("fastq2") or val.get("read2")
        if r2:
            return (_abs(r1), _abs(r2))
        return (_abs(r1),)
    return (_abs(val),)


def _is_paired(sample):
    return len(_get_fastq_paths(sample)) == 2


def _paired_all_samples():
    if not samples:
        return False
    return all(_is_paired(sample) for sample in samples)


PAIRED_END = _paired_all_samples()


def _fastp_expected_outputs():
    outputs = []
    for sample in samples:
        if PAIRED_END:
            outputs.append(_fastp_out_r1(sample))
            outputs.append(_fastp_out_r2(sample))
        else:
            outputs.append(_fastp_out_se(sample))
        outputs.append(_fastp_json(sample))
        outputs.append(_fastp_html(sample))
    return outputs


def _fastp_reads(sample):
    if PAIRED_END:
        return [_fastp_out_r1(sample), _fastp_out_r2(sample)]
    return [_fastp_out_se(sample)]


FASTP_OUT_SE = os.path.join(OUTDIR, "fastp", "{sample}.fastq")
FASTP_OUT_R1 = os.path.join(OUTDIR, "fastp", "{sample}_R1.fastq")
FASTP_OUT_R2 = os.path.join(OUTDIR, "fastp", "{sample}_R2.fastq")
FASTP_JSON = os.path.join(OUTDIR, "fastp", "{sample}.json")
FASTP_HTML = os.path.join(OUTDIR, "fastp", "{sample}.html")


def _fastp_out_se(sample):
    return FASTP_OUT_SE.format(sample=sample)


def _fastp_out_r1(sample):
    return FASTP_OUT_R1.format(sample=sample)


def _fastp_out_r2(sample):
    return FASTP_OUT_R2.format(sample=sample)


def _fastp_json(sample):
    return FASTP_JSON.format(sample=sample)


def _fastp_html(sample):
    return FASTP_HTML.format(sample=sample)


