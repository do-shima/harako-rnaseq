def _abs(path):
    if path is None:
        return None
    if os.path.isabs(path):
        return path
    if INDIR:
        return os.path.join(INDIR, path)
    if CONFIG_DIR:
        return os.path.join(str(CONFIG_DIR), path)
    return os.path.join(str(BASEDIR), path)


def _load_yaml(path):
    try:
        import yaml
    except ImportError as exc:
        raise ValueError("PyYAML is required to load ref_manifest.yaml") from exc
    with open(path, "r", encoding="utf-8") as handle:
        return yaml.safe_load(handle) or {}


def _ref_from_manifest(preset, release, manifest_path, cache_dir):
    if not preset:
        return None
    manifest = manifest_path or str(BASEDIR / "ref_manifest.yaml")
    if not os.path.exists(manifest):
        raise ValueError(f"Ref manifest not found: {manifest}")
    data = _load_yaml(manifest)
    validate_builtin_manifest(data)
    canonical, canonical_release, _ = get_release_entry(data, preset, release)
    cache_root = cache_dir or os.path.join(OUTDIR, "refs_cache")
    existing = resolve_existing_cache_paths(
        data, Path(cache_root), preset, release
    )
    target_dir = (
        str(existing["directory"])
        if existing
        else os.path.join(cache_root, canonical, canonical_release)
    )
    return {
        "transcripts_fasta": os.path.join(target_dir, "transcripts.fa.gz"),
        "genome_fasta": os.path.join(target_dir, "genome.fa.gz"),
        "gtf": os.path.join(target_dir, "annotation.gtf.gz"),
    }


def _load_sample_table(path):
    if not path:
        return None
    if not os.path.exists(path):
        raise ValueError(f"Sample table not found: {path}")
    rows = []
    with open(path, "r", newline="") as handle:
        peek = handle.read(2048)
        handle.seek(0)
        delimiter = "\t"
        try:
            sniffed = csv.Sniffer().sniff(peek, delimiters=",\t")
            delimiter = sniffed.delimiter
        except csv.Error:
            delimiter = "\t"
        reader = csv.DictReader(handle, delimiter=delimiter)
        for row in reader:
            rows.append(row)
    return rows


