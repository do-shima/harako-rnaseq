import os
import csv
from pathlib import Path


BASEDIR = Path(workflow.basedir)
SCRIPTS = BASEDIR / "scripts"
TOPDIR = BASEDIR.parent
TOP_SCRIPTS = TOPDIR / "scripts"

OUTDIR = config["output"]
INDIR = config.get("input")
ENGINE = config.get("engine", "real")
THREADS = int(config.get("threads", 1))
SPECIES = config.get("species", "mouse")
ENRICH_CFG = config.get("enrichment", {})
ENRICH_ENABLE = bool(ENRICH_CFG.get("enable", False))
ENRICH_OUTDIR = os.path.join(OUTDIR, "results", "enrichment")
ENRICH_DONE = os.path.join(ENRICH_OUTDIR, "enrichment.done")

CONFIG_DIR = None
if hasattr(workflow, "configfiles") and workflow.configfiles:
    CONFIG_DIR = Path(workflow.configfiles[0]).resolve().parent
elif config.get("config_dir"):
    CONFIG_DIR = Path(config["config_dir"]).resolve()
else:
    CONFIG_DIR = BASEDIR


def _abs(path):
    if path is None:
        return None
    if os.path.isabs(path):
        return path
    if INDIR:
        return os.path.join(INDIR, path)
    if CONFIG_DIR:
        return os.path.join(str(CONFIG_DIR), path)
    return os.path.join(str(BASEDIR), path)


def _ref_from_manifest(preset, manifest_path):
    if not preset:
        return None
    manifest = manifest_path or str(BASEDIR / "refs_manifest.tsv")
    if not os.path.exists(manifest):
        raise ValueError(f"Ref manifest not found: {manifest}")

    with open(manifest, "r", newline="") as handle:
        reader = csv.DictReader(handle, delimiter="\t")
        for row in reader:
            if row.get("preset") == preset:
                return {
                    "transcripts_fasta": row.get("transcripts_fasta") or None,
                    "genome_fasta": row.get("genome_fasta") or None,
                    "gtf": row.get("gtf") or None,
                }
    raise ValueError(f"Preset not found in manifest: {preset}")


def _load_sample_table(path):
    if not path:
        return None
    if not os.path.exists(path):
        raise ValueError(f"Sample table not found: {path}")
    rows = []
    with open(path, "r", newline="") as handle:
        peek = handle.read(2048)
        handle.seek(0)
        delimiter = "\t"
        try:
            sniffed = csv.Sniffer().sniff(peek, delimiters=",\t")
            delimiter = sniffed.delimiter
        except csv.Error:
            delimiter = "\t"
        reader = csv.DictReader(handle, delimiter=delimiter)
        for row in reader:
            rows.append(row)
    return rows


sample_table = _abs(config.get("sample_table"))
sample_rows = _load_sample_table(sample_table) if sample_table else None

samples = config.get("samples", [])
fastq_map = config.get("fastq", {})
fastq1_map = config.get("fastq1", {})
fastq2_map = config.get("fastq2", {})
conditions_map = config.get("conditions", {})

if sample_rows:
    samples = [row.get("sample") for row in sample_rows if row.get("sample")]
    for row in sample_rows:
        sample_id = row.get("sample")
        if not sample_id:
            continue
        if row.get("condition"):
            conditions_map[sample_id] = row.get("condition")
        if row.get("fastq1"):
            fastq1_map[sample_id] = _abs(row.get("fastq1"))
        if row.get("fastq2"):
            fastq2_map[sample_id] = _abs(row.get("fastq2"))
tx2gene_tsv = _abs(config.get("tx2gene_tsv"))

ref_cfg = config.get("ref") or {}
ref_preset = config.get("ref_preset")
ref_manifest = config.get("ref_manifest")

if ref_preset and not ref_cfg:
    ref_cfg = _ref_from_manifest(ref_preset, ref_manifest)

def _get_ref(key):
    tried = [f"ref.{key}", f"ref.{SPECIES}.{key}"]
    if ref_cfg.get(key):
        return _abs(ref_cfg.get(key))
    species_cfg = ref_cfg.get(SPECIES, {})
    if isinstance(species_cfg, dict) and species_cfg.get(key):
        return _abs(species_cfg.get(key))
    cfg_paths = []
    if hasattr(workflow, "configfiles") and workflow.configfiles:
        cfg_paths = [str(p) for p in workflow.configfiles]
    raise ValueError(
        f"[refs] species={SPECIES} missing_ref_key={key} "
        f"tried={','.join(tried)} configfiles={cfg_paths}"
    )


transcripts_fasta = _get_ref("transcripts_fasta")
genome_fasta = _get_ref("genome_fasta")
gtf = _get_ref("gtf")

print(
    f"[refs] species={SPECIES} transcripts_fasta={transcripts_fasta} "
    f"genome_fasta={genome_fasta} gtf={gtf}"
)

if ENGINE == "real" and not transcripts_fasta:
    raise ValueError("transcripts_fasta is required for engine=real.")


def _get_fastq_paths(sample):
    if fastq1_map or fastq2_map:
        r1 = fastq1_map.get(sample)
        if sample in fastq2_map:
            return (_abs(r1), _abs(fastq2_map[sample]))
        return (_abs(r1),)
    val = fastq_map[sample]
    if isinstance(val, dict):
        r1 = val.get("r1") or val.get("fastq1") or val.get("read1")
        r2 = val.get("r2") or val.get("fastq2") or val.get("read2")
        if r2:
            return (_abs(r1), _abs(r2))
        return (_abs(r1),)
    return (_abs(val),)


def _is_paired(sample):
    return len(_get_fastq_paths(sample)) == 2


def _paired_all_samples():
    if not samples:
        return False
    return all(_is_paired(sample) for sample in samples)


PAIRED_END = _paired_all_samples()


def _fastp_expected_outputs():
    outputs = []
    for sample in samples:
        if PAIRED_END:
            outputs.append(os.path.join(OUTDIR, "fastp", f"{sample}_R1.fastq"))
            outputs.append(os.path.join(OUTDIR, "fastp", f"{sample}_R2.fastq"))
        else:
            outputs.append(os.path.join(OUTDIR, "fastp", f"{sample}.fastq"))
        outputs.append(os.path.join(OUTDIR, "fastp", f"{sample}.json"))
        outputs.append(os.path.join(OUTDIR, "fastp", f"{sample}.html"))
    return outputs


def _fastp_reads(sample):
    if PAIRED_END:
        return [
            os.path.join(OUTDIR, "fastp", f"{sample}_R1.fastq"),
            os.path.join(OUTDIR, "fastp", f"{sample}_R2.fastq"),
        ]
    return [os.path.join(OUTDIR, "fastp", f"{sample}.fastq")]


all_outputs = [
    os.path.join(OUTDIR, "report", "report.html"),
    os.path.join(OUTDIR, "deseq2", "results.tsv"),
    os.path.join(OUTDIR, "tximport", "txi.tsv"),
    expand(os.path.join(OUTDIR, "salmon", "{sample}", "quant.sf"), sample=samples),
]
all_outputs.extend(_fastp_expected_outputs())
all_outputs.extend([
    os.path.join(OUTDIR, "deseq2", "qc_summary.tsv"),
    os.path.join(OUTDIR, "deseq2", "qc_summary.json"),
    os.path.join(OUTDIR, "deseq2", "padj_hist.png"),
    os.path.join(OUTDIR, "deseq2", "lfc_hist.png"),
    os.path.join(OUTDIR, "deseq2", "mean_vs_lfc.png"),
    os.path.join(OUTDIR, "deseq2", "volcano.png"),
])

if ENGINE == "real":
    all_outputs.append(os.path.join(OUTDIR, "tximport", "tpm.tsv"))
    all_outputs.append(os.path.join(OUTDIR, "tximport", "qc_library_sizes.tsv"))
    all_outputs.append(os.path.join(OUTDIR, "deseq2", "normalized_counts.tsv"))
    all_outputs.append(os.path.join(OUTDIR, "deseq2", "pca.png"))
    all_outputs.append(os.path.join(OUTDIR, "deseq2", "sample_distance_heatmap.png"))
    all_outputs.append(os.path.join(OUTDIR, "deseq2", "ma_plot.png"))
    if ENRICH_ENABLE:
        all_outputs.append(ENRICH_DONE)

fastp_jsons = expand(os.path.join(OUTDIR, "fastp", "{sample}.json"), sample=samples)
fastp_htmls = expand(os.path.join(OUTDIR, "fastp", "{sample}.html"), sample=samples)
salmon_quants = expand(os.path.join(OUTDIR, "salmon", "{sample}", "quant.sf"), sample=samples)
salmon_meta = expand(os.path.join(OUTDIR, "salmon", "{sample}", "meta_info.json"), sample=samples)


rule all:
    input:
        all_outputs


if ENGINE == "stub":
