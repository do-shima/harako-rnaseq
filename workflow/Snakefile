if PAIRED_END:
    rule fastp:
        input:
            r1=lambda wildcards: _get_fastq_paths(wildcards.sample)[0],
            r2=lambda wildcards: _get_fastq_paths(wildcards.sample)[1]
        output:
            fastq1=FASTP_OUT_R1,
            fastq2=FASTP_OUT_R2,
            json=FASTP_JSON,
            html=FASTP_HTML
        threads: THREADS
        resources:
            tmpdir="/tmp"
        run:
            if ENGINE == "stub":
                shell(f"python {SCRIPTS / 'fastp_stub.py'} {input.r1} {output.fastq1} {output.json} {output.html}")
                shell(f"python {SCRIPTS / 'fastp_stub.py'} {input.r2} {output.fastq2}")
            elif ENGINE == "real":
                if shutil.which("fastp") is None:
                    raise ValueError("fastp binary not found for engine=real.")
                shell(
                    "fastp -i {input.r1} -I {input.r2} -o {output.fastq1} -O {output.fastq2} "
                    "-j {output.json} -h {output.html} -w {threads}"
                )
            else:
                raise ValueError(f"Unsupported engine for fastp: {ENGINE}")
else:
    rule fastp:
        input:
