            index=os.path.join(OUTDIR, "salmon", "index", "index.done"),
            reads=os.path.join(OUTDIR, "fastp", "{sample}.fastq")
        output:
            os.path.join(OUTDIR, "salmon", "{sample}", "quant.sf")
        script:
            str(SCRIPTS / "salmon_quant_stub.py")

    rule tximport:
        input:
            expand(os.path.join(OUTDIR, "salmon", "{sample}", "quant.sf"), sample=samples)
        output:
            os.path.join(OUTDIR, "tximport", "txi.tsv")
        script:
            str(TOP_SCRIPTS / "tximport_stub.py")

    rule deseq2:
        input:
            os.path.join(OUTDIR, "tximport", "txi.tsv")
        output:
            os.path.join(OUTDIR, "deseq2", "results.tsv")
        script:
            str(TOP_SCRIPTS / "deseq2_stub.py")

    rule deseq2_qc:
        input:
            results=os.path.join(OUTDIR, "deseq2", "results.tsv")
        output:
            summary_tsv=os.path.join(OUTDIR, "deseq2", "qc_summary.tsv"),
            summary_json=os.path.join(OUTDIR, "deseq2", "qc_summary.json"),
            padj_hist=os.path.join(OUTDIR, "deseq2", "padj_hist.png"),
            lfc_hist=os.path.join(OUTDIR, "deseq2", "lfc_hist.png"),
            mean_vs_lfc=os.path.join(OUTDIR, "deseq2", "mean_vs_lfc.png"),
            volcano=os.path.join(OUTDIR, "deseq2", "volcano.png")
        script:
            str(TOP_SCRIPTS / "deseq2_qc_stub.py")

    rule report:
        input:
            results=os.path.join(OUTDIR, "deseq2", "results.tsv"),
            qc_summary=os.path.join(OUTDIR, "deseq2", "qc_summary.tsv"),
            qc_json=os.path.join(OUTDIR, "deseq2", "qc_summary.json"),
            padj_hist=os.path.join(OUTDIR, "deseq2", "padj_hist.png"),
            lfc_hist=os.path.join(OUTDIR, "deseq2", "lfc_hist.png"),
            mean_vs_lfc=os.path.join(OUTDIR, "deseq2", "mean_vs_lfc.png"),
            volcano=os.path.join(OUTDIR, "deseq2", "volcano.png")
        output:
            os.path.join(OUTDIR, "report", "report.html")
        script:
            str(TOP_SCRIPTS / "report_stub.py")

else:
    rule sample_table:
        output:
            os.path.join(OUTDIR, "metadata", "samples.tsv")
        run:
            os.makedirs(os.path.dirname(output[0]), exist_ok=True)
            if sample_table:
                shell("cp {sample_table} {output[0]}")
            else:
                if not conditions_map:
                    raise ValueError("Provide either sample_table or conditions mapping in config.")
                with open(output[0], "w", encoding="utf-8") as handle:
                    handle.write("sample\tcondition\n")
                    for sample in samples:
                        condition = conditions_map.get(sample)
                        if condition is None:
                            raise ValueError(f"Missing condition for sample: {sample}")
                        handle.write(f"{sample}\t{condition}\n")

    if PAIRED_END:
        rule fastp_pe:
            input:
                lambda wildcards: _get_fastq_paths(wildcards.sample)
            output:
                fastq1=os.path.join(OUTDIR, "fastp", "{sample}_R1.fastq"),
                fastq2=os.path.join(OUTDIR, "fastp", "{sample}_R2.fastq"),
                json=os.path.join(OUTDIR, "fastp", "{sample}.json"),
                html=os.path.join(OUTDIR, "fastp", "{sample}.html")
            threads: THREADS
            shell:
                "fastp -i {input[0]} -I {input[1]} -o {output.fastq1} -O {output.fastq2} "
                "-j {output.json} -h {output.html} -w {threads}"
    else:
        rule fastp_se:
            input:
                lambda wildcards: _get_fastq_paths(wildcards.sample)[0]
            output:
                fastq=os.path.join(OUTDIR, "fastp", "{sample}.fastq"),
                json=os.path.join(OUTDIR, "fastp", "{sample}.json"),
                html=os.path.join(OUTDIR, "fastp", "{sample}.html")
            threads: THREADS
            shell:
                "fastp -i {input} -o {output.fastq} -j {output.json} -h {output.html} -w {threads}"

    if genome_fasta:
        rule gentrome:
            input:
                transcripts=transcripts_fasta,
                genome=genome_fasta
            output:
                gentrome=os.path.join(OUTDIR, "salmon", "gentrome.fa.gz"),
                decoys=os.path.join(OUTDIR, "salmon", "decoys.txt")
            params:
                tmp_gentrome="/tmp/gentrome.fa.gz.tmp",
                tmp_decoys="/tmp/decoys.txt.tmp"
            log:
                os.path.join(OUTDIR, "logs", "gentrome.log")
            shell:
                r"""
                set -euo pipefail
                mkdir -p $(dirname "{log}")
                mkdir -p $(dirname "{output.gentrome}")/.tmp
                output_dir_tmp="$(dirname "{output.gentrome}")/.tmp"

                # エラー時に tmp を掃除
                trap 'rm -f "{params.tmp_gentrome}" "{params.tmp_decoys}" "$output_dir_tmp/gentrome.fa.gz.tmp" "$output_dir_tmp/decoys.txt.tmp"' ERR

                echo '[gentrome] input_check' > "{log}"
                ls -lh "{input.transcripts}" "{input.genome}" >> "{log}"

                echo '[gentrome] build (tmp)' >> "{log}"
                rm -f "{params.tmp_gentrome}" "{params.tmp_decoys}"
                python "{SCRIPTS}/build_gentrome.py" \
                  --transcripts "{input.transcripts}" \
                  --genome "{input.genome}" \
                  --gentrome "{params.tmp_gentrome}" \
                  --decoys "{params.tmp_decoys}" >> "{log}" 2>&1

                echo '[gentrome] validate' >> "{log}"
                gzip -t "{params.tmp_gentrome}" >> "{log}" 2>&1
                ls -lh "{params.tmp_gentrome}" "{params.tmp_decoys}" >> "{log}"

                echo '[gentrome] finalize (atomic rename)' >> "{log}"
                cp "{params.tmp_gentrome}" "$output_dir_tmp/gentrome.fa.gz.tmp"
                cp "{params.tmp_decoys}" "$output_dir_tmp/decoys.txt.tmp"
                mv -f "$output_dir_tmp/gentrome.fa.gz.tmp" "{output.gentrome}"
                mv -f "$output_dir_tmp/decoys.txt.tmp" "{output.decoys}"
                ls -lh "{output.gentrome}" "{output.decoys}" >> "{log}"
                """
        

        rule salmon_index:
            input:
                gentrome=os.path.join(OUTDIR, "salmon", "gentrome.fa.gz"),
                decoys=os.path.join(OUTDIR, "salmon", "decoys.txt")
            output:
                directory(os.path.join(OUTDIR, "salmon", "index"))
            threads: THREADS
            shell:
                "salmon index -t {input.gentrome} -d {input.decoys} -i {output} -k 31 -p {threads}"
    else:
        rule salmon_index:
            input:
                transcripts=transcripts_fasta
            output:
                directory(os.path.join(OUTDIR, "salmon", "index"))
            threads: THREADS
            shell:
                "salmon index -t {input.transcripts} -i {output} -k 31 -p {threads}"

    rule salmon_quant:
        input:
            index=os.path.join(OUTDIR, "salmon", "index"),
            reads=lambda wildcards: _fastp_reads(wildcards.sample)
        output:
            quant=os.path.join(OUTDIR, "salmon", "{sample}", "quant.sf"),
            meta=os.path.join(OUTDIR, "salmon", "{sample}", "meta_info.json")
        log:
            os.path.join(OUTDIR, "logs", "salmon_quant", "{sample}.log")
        threads: THREADS
        run:
            import os
            import shutil
            import subprocess

            outdir = os.path.dirname(output.quant)
            os.makedirs(outdir, exist_ok=True)
            paired = len(input.reads) == 2
            os.makedirs(os.path.dirname(log[0]), exist_ok=True)

            if paired:
                cmd = [
                    "salmon", "quant",
                    "-i", input.index,
                    "-l", "A",
                    "-1", input.reads[0],
                    "-2", input.reads[1],
                    "-p", str(threads),
                    "-o", outdir,
                ]
            else:
                cmd = [
                    "salmon", "quant",
                    "-i", input.index,
                    "-l", "A",
                    "-r", input.reads[0],
                    "-p", str(threads),
                    "-o", outdir,
                ]

            with open(log[0], "w", encoding="utf-8") as handle:
                handle.write("[salmon_quant] command: " + " ".join(cmd) + "\n")
                subprocess.run(cmd, check=True, stdout=handle, stderr=handle)

            aux_meta = os.path.join(outdir, "aux_info", "meta_info.json")
            if os.path.exists(aux_meta) and not os.path.exists(output.meta):
                shutil.copyfile(aux_meta, output.meta)

            missing = []
            for path in (output.quant, output.meta):
                if not os.path.exists(path):
                    missing.append(path)
            if missing:
                with open(log[0], "a", encoding="utf-8") as handle:
                    handle.write("[salmon_quant] missing outputs:\n")
                    for path in missing:
                        handle.write(f"- {path}\n")
                    handle.write("[salmon_quant] directory listing:\n")
                    for root, dirs, files in os.walk(outdir):
                        handle.write(f"{root}:\n")
                        for name in sorted(dirs):
                            handle.write(f"  [d] {name}\n")
                        for name in sorted(files):
                            handle.write(f"  [f] {name}\n")
                raise RuntimeError("salmon_quant missing expected outputs")

    rule tximport:
        input:
            quant=expand(os.path.join(OUTDIR, "salmon", "{sample}", "quant.sf"), sample=samples),
            gtf=gtf if gtf else [],
            tx2gene=tx2gene_tsv if tx2gene_tsv else []
        output:
            counts=os.path.join(OUTDIR, "tximport", "txi.tsv"),
            tpm=os.path.join(OUTDIR, "tximport", "tpm.tsv"),
            qc=os.path.join(OUTDIR, "tximport", "qc_library_sizes.tsv")
        params:
            samples=samples
        script:
            str(TOP_SCRIPTS / "tximport_real.R")

    rule deseq2:
        input:
            counts=os.path.join(OUTDIR, "tximport", "txi.tsv"),
            sample_table=os.path.join(OUTDIR, "metadata", "samples.tsv")
        output:
            results=os.path.join(OUTDIR, "deseq2", "results.tsv"),
            normalized=os.path.join(OUTDIR, "deseq2", "normalized_counts.tsv"),
            pca=os.path.join(OUTDIR, "deseq2", "pca.png"),
            heatmap=os.path.join(OUTDIR, "deseq2", "sample_distance_heatmap.png"),
            ma=os.path.join(OUTDIR, "deseq2", "ma_plot.png")
        params:
            contrasts=config.get("contrasts", [])
        script:
            str(TOP_SCRIPTS / "deseq2_real.R")

    rule deseq2_qc:
        input:
            results=os.path.join(OUTDIR, "deseq2", "results.tsv"),
            normalized=os.path.join(OUTDIR, "deseq2", "normalized_counts.tsv"),
            sample_table=os.path.join(OUTDIR, "metadata", "samples.tsv")
        output:
            summary_tsv=os.path.join(OUTDIR, "deseq2", "qc_summary.tsv"),
            summary_json=os.path.join(OUTDIR, "deseq2", "qc_summary.json"),
            padj_hist=os.path.join(OUTDIR, "deseq2", "padj_hist.png"),
            lfc_hist=os.path.join(OUTDIR, "deseq2", "lfc_hist.png"),
            mean_vs_lfc=os.path.join(OUTDIR, "deseq2", "mean_vs_lfc.png"),
            volcano=os.path.join(OUTDIR, "deseq2", "volcano.png")
        script:
            str(TOP_SCRIPTS / "deseq2_qc_real.R")

    rule enrichment:
        input:
            results=os.path.join(OUTDIR, "deseq2", "results.tsv")
        output:
            done=ENRICH_DONE
        params:
            outdir=ENRICH_OUTDIR,
            species=SPECIES,
            alpha=ENRICH_CFG.get("alpha", 0.05),
            lfc=ENRICH_CFG.get("lfc", 0),
            top_terms=ENRICH_CFG.get("top_terms", 15),
            methods=ENRICH_CFG.get("methods", ["ORA", "GSEA"]),
            rank_metric=ENRICH_CFG.get("rank_metric", "stat")
        script:
            str(TOP_SCRIPTS / "enrichment_run.R")

    rule report:
        input:
            results=os.path.join(OUTDIR, "deseq2", "results.tsv"),
            normalized=os.path.join(OUTDIR, "deseq2", "normalized_counts.tsv"),
            pca=os.path.join(OUTDIR, "deseq2", "pca.png"),
            heatmap=os.path.join(OUTDIR, "deseq2", "sample_distance_heatmap.png"),
            ma=os.path.join(OUTDIR, "deseq2", "ma_plot.png"),
            qc_summary=os.path.join(OUTDIR, "deseq2", "qc_summary.tsv"),
            qc_json=os.path.join(OUTDIR, "deseq2", "qc_summary.json"),
            padj_hist=os.path.join(OUTDIR, "deseq2", "padj_hist.png"),
            lfc_hist=os.path.join(OUTDIR, "deseq2", "lfc_hist.png"),
            mean_vs_lfc=os.path.join(OUTDIR, "deseq2", "mean_vs_lfc.png"),
            volcano=os.path.join(OUTDIR, "deseq2", "volcano.png"),
            fastp_jsons=fastp_jsons,
            fastp_htmls=fastp_htmls,
            salmon_quants=salmon_quants,
            salmon_meta=salmon_meta,
            tximport=os.path.join(OUTDIR, "tximport", "txi.tsv")
        output:
            os.path.join(OUTDIR, "report", "report.html")
        params:
            report_dir=os.path.join(OUTDIR, "report"),
            report_src=str(TOP_SCRIPTS / "report_real.Rmd"),
            deseq2_dir=os.path.join(OUTDIR, "deseq2"),
            tximport_dir=os.path.join(OUTDIR, "tximport"),
            sample_table=os.path.join(OUTDIR, "metadata", "samples.tsv"),
            pipeline_outdir=OUTDIR
        shell:
            "Rscript -e \"rmarkdown::render('{params.report_src}', output_file='report.html', "
            "output_dir='{params.report_dir}', params=list(outdir='{params.pipeline_outdir}', "
            "fastp_dir='{params.pipeline_outdir}/fastp', salmon_dir='{params.pipeline_outdir}/salmon', "
            "tximport_dir='{params.tximport_dir}', deseq2_dir='{params.deseq2_dir}', "
            "sample_table='{params.sample_table}'), output_options=list(self_contained=TRUE))\""
