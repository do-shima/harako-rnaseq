{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://do-shima.github.io/harako-rnaseq/schemas/harako-agent-plan-v1.schema.json",
  "title": "Harako-RNAseq agent plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "harako_version", "plan_id", "created_at_utc",
    "input_root", "output_root", "project_name", "samples", "reference",
    "analysis_plan", "contrasts", "enrichment", "resources",
    "requested_options", "warnings", "unresolved", "approval_required",
    "approval_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "harako_version": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "input_root": {"type": "string", "minLength": 1},
    "output_root": {"type": "string", "minLength": 1},
    "project_name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "library_protocol": {"enum": ["full_length", "three_prime_tag"]},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample", "condition", "fastq1", "fastq2", "pairing_status"],
        "properties": {
          "sample": {"type": "string", "minLength": 1},
          "condition": {"type": "string"},
          "fastq1": {"type": "string", "minLength": 1},
          "fastq2": {"type": "string"},
          "pairing_status": {"enum": ["paired", "single-end", "unresolved"]}
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["species", "requested_preset", "canonical_preset", "release", "assembly", "manifest_path", "cache_dir", "expected_paths", "checksum_verified", "provenance"],
      "properties": {
        "species": {"type": "string", "minLength": 1},
        "requested_preset": {"type": "string", "minLength": 1},
        "canonical_preset": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1},
        "assembly": {"type": ["string", "null"]},
        "manifest_path": {"type": "string", "minLength": 1},
        "cache_dir": {"type": "string", "minLength": 1},
        "expected_paths": {"type": "object", "additionalProperties": {"type": "string"}},
        "checksum_verified": {"type": "boolean"},
        "provenance": {"type": "object"}
      }
    },
    "analysis_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "policy_version", "mode", "structurally_valid", "eligible_for_de", "reason_code", "condition_counts", "total_samples", "contrast_allowed", "enrichment_allowed"],
      "properties": {
        "schema_version": {"const": 1},
        "policy_version": {"const": 1},
        "mode": {"enum": ["differential", "qc_only", "invalid"]},
        "structurally_valid": {"type": "boolean"},
        "eligible_for_de": {"type": "boolean"},
        "reason_code": {"type": "string"},
        "condition_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "total_samples": {"type": "integer", "minimum": 0},
        "contrast_allowed": {"type": "boolean"},
        "enrichment_allowed": {"type": "boolean"}
      }
    },
    "contrasts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reference", "pairs", "active"],
      "properties": {
        "mode": {"type": ["string", "null"]},
        "reference": {"type": ["string", "null"]},
        "pairs": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}], "minItems": 2, "maxItems": 2}},
        "active": {"type": "boolean"}
      }
    },
    "enrichment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "enabled", "eligible"],
      "properties": {
        "requested": {"type": "boolean"},
        "enabled": {"type": "boolean"},
        "eligible": {"type": "boolean"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threads", "execution_engine"],
      "properties": {
        "threads": {"type": "integer", "minimum": 1},
        "execution_engine": {"const": "real"}
      }
    },
    "requested_options": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "approval_required": {"const": true},
    "approval_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
