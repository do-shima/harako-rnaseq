# Version control, editors, and OS metadata
.git/
.github/
.idea/
.vscode/
**/.DS_Store
**/Thumbs.db
**/*.swp
**/*.swo
**/*~

# Python, R, and Node caches
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
config/vulnerability-dispositions-*.json
docs/vulnerability-review-*.md
**/.venv/
**/venv/
**/.tox/
**/.nox/
**/.Rhistory
**/.RData
**/node_modules/
**/.next/
**/.nuxt/
**/dist/
**/build/

# Workflow state, logs, and temporary files
**/.snakemake/
**/snakemake_logs/
**/logs/
**/log/
**/*.log
**/*.tmp
**/*.partial
**/*.part
**/.cache/
**/tmp/
**/temp/

# Local input, output, references, and generated reports
input/
output/
data/
data_in/
data_out/
out/
out*/
results/
report/
reports/
refs/
refs_cache/
ref_cache/
reference-checksums/

# Sequencing, alignment, and reference data
**/*.fastq
**/*.fq
**/*.fastq.gz
**/*.fq.gz
**/*.bam
**/*.bai
**/*.sam
**/*.cram
**/*.crai
**/*.sra
**/*.vcf
**/*.vcf.gz
**/*.bcf
**/*.gtf
**/*.gtf.gz
**/*.gff
**/*.gff.gz
**/*.gff3
**/*.fa
**/*.fasta
**/*.fna
**/*.fa.gz
**/*.fasta.gz
**/*.fna.gz
**/*.bed
**/*.bed.gz

# Bulky scientific and archive formats
**/*.tif
**/*.tiff
**/*.nd2
**/*.h5
**/*.hdf5
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.7z

# Small fixtures required by offline tests and smoke validation
!tests/**/*.fastq
!tests/**/*.fastq.gz
!tests/**/*.fq
!tests/**/*.fq.gz
!tests/**/*.fa
!tests/**/*.fasta
!tests/**/*.gtf
!tests/**/*.bed
!tests/**/*.tsv
!tests/**/*.json
