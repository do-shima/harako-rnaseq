from pathlib import Path

ROOT = Path("tests/enrichment_fixture")
OUT = ROOT / "out"
DESEQ = OUT / "deseq2" / "results.tsv"
DESEQ_STATUS = OUT / "deseq2" / "status.json"
SAMPLES = OUT / "metadata" / "samples.tsv"
ENRICH_DIR = OUT / "results" / "enrichment"
CONTRAST = "A_vs_B"
STATUS = ENRICH_DIR / f"contrast={CONTRAST}" / "status.json"

BASEDIR = Path(workflow.basedir)
TOPDIR = BASEDIR.parents[1]

rule all:
    input:
        OUT / "report" / "report.html",
        STATUS,
        OUT / "enrichment.ok"

rule prep:
    output:
        results=str(DESEQ),
        status=str(DESEQ_STATUS),
        sample_table=str(SAMPLES)
    run:
        import json

        for p in output:
            Path(p).parent.mkdir(parents=True, exist_ok=True)
        src = BASEDIR / "results.tsv"
        Path(output.results).write_text(src.read_text(encoding="utf-8"), encoding="utf-8")
        Path(output.status).write_text(
            json.dumps(
                {
                    "schema_version": 1,
                    "policy_version": 1,
                    "mode": "differential",
                    "structurally_valid": True,
                    "eligible_for_de": True,
                    "reason_code": "eligible",
                    "condition_counts": {"A": 2, "B": 2},
                    "total_samples": 4,
                    "differential_results_available": True,
                    "enrichment_allowed": True,
                }
            )
            + "\n",
            encoding="utf-8",
        )
        Path(output.sample_table).write_text(
            "sample\tcondition\nS1\tA\nS2\tA\nS3\tB\nS4\tB\n",
            encoding="utf-8",
        )

rule enrichment:
    input:
        results=str(DESEQ),
        status=str(DESEQ_STATUS)
    output:
        status=STATUS,
        done=ENRICH_DIR / "enrichment.done"
    params:
        outdir=str(ENRICH_DIR),
        species="human",
        alpha=0.05,
        lfc=0,
        top_terms=10,
        methods=["ORA", "GSEA"],
        rank_metric="stat"
    script:
        str(TOPDIR / "scripts" / "enrichment_run.R")

rule report:
    input:
        results=str(DESEQ),
        sample_table=str(SAMPLES)
    output:
        OUT / "report" / "report.html"
    params:
        report_dir=str(OUT / "report"),
        report_src=str(TOPDIR / "scripts" / "report_real.Rmd"),
        deseq2_dir=str(OUT / "deseq2"),
        tximport_dir=str(OUT / "tximport"),
        sample_table=str(SAMPLES),
        pipeline_outdir=str(OUT),
        enrichment_dir=str(ENRICH_DIR)
    shell:
        "Rscript -e \"rmarkdown::render('{params.report_src}', output_file='report.html', "
        "output_dir='{params.report_dir}', params=list(outdir='{params.pipeline_outdir}', "
        "fastp_dir='{params.pipeline_outdir}/fastp', salmon_dir='{params.pipeline_outdir}/salmon', "
        "tximport_dir='{params.tximport_dir}', deseq2_dir='{params.deseq2_dir}', "
        "enrichment_dir='{params.enrichment_dir}', sample_table='{params.sample_table}'), "
        "output_options=list(self_contained=TRUE))\""

rule check:
    input:
        status=STATUS,
        report=OUT / "report" / "report.html"
    output:
        OUT / "enrichment.ok"
    run:
        import json
        from pathlib import Path

        payload = json.loads(Path(input.status).read_text(encoding="utf-8"))
        assert "ok" in payload and "skipped" in payload and "reason" in payload

        report_text = Path(input.report).read_text(encoding="utf-8")
        assert "Harako-RNAseq Report" in report_text
        assert "Gene set enrichment" in report_text
        assert "data:image/" in report_text

        base = ENRICH_DIR / f"contrast={CONTRAST}"
        ora = base / "ora_go_bp.tsv"
        gsea = base / "gsea_go_bp.tsv"
        if ora.exists():
            header = ora.read_text(encoding="utf-8").splitlines()[0]
            assert header.split("\t") == [
                "term_id", "description", "pvalue", "padj", "gene_count", "gene_ratio", "bg_ratio", "genes"
            ]
        if gsea.exists():
            header = gsea.read_text(encoding="utf-8").splitlines()[0]
            assert header.split("\t") == [
                "term_id", "description", "pvalue", "padj", "NES", "size", "leading_edge"
            ]
        Path(output[0]).write_text("ok\n", encoding="utf-8")
