from pathlib import Path

BASEDIR = Path(workflow.basedir)
TOPDIR = BASEDIR.parents[1]
DATADIR = TOPDIR / "tests" / "data_rat_min"
OUTDIR = BASEDIR / "out"

rule all:
    input:
        OUTDIR / "tximport" / "header.ok"

rule tximport:
    input:
        quant=[str(DATADIR / "salmon" / "SRR14340927" / "quant.sf")],
        gtf=str(DATADIR / "genes.gtf")
    output:
        counts=str(OUTDIR / "tximport" / "txi.tsv"),
        tpm=str(OUTDIR / "tximport" / "tpm.tsv"),
        qc=str(OUTDIR / "tximport" / "qc_library_sizes.tsv")
    script:
        str(TOPDIR / "scripts" / "tximport_real.R")

rule check_header:
    input:
        counts=OUTDIR / "tximport" / "txi.tsv"
    output:
        OUTDIR / "tximport" / "header.ok"
    run:
        header = ""
        with open(input.counts, "r", encoding="utf-8") as handle:
            header = handle.readline().strip()
        if "SRR14340927" not in header:
            raise ValueError(f"missing sample name in header: {header}")
        if "\tV1" in header or header.startswith("gene_id\tV1"):
            raise ValueError(f"unexpected default column name in header: {header}")
        Path(output[0]).write_text("ok\n", encoding="utf-8")
